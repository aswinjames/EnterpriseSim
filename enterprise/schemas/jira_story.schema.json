{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprisesim.dev/schemas/2020-12/jira_story.schema.json",
  "title": "JiraStory",
  "description": "A Jira issue (story/bug/task/epic/spike/hotfix) using per-project keys per CANON-001 §5.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/eclObjectBase" }],
  "required": ["id", "type", "title", "app", "team", "sprint", "status", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z]{2,4}-\\d+$" },
    "type": { "type": "string", "enum": ["epic", "story", "bug", "task", "spike", "hotfix"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "app": { "$ref": "common.schema.json#/$defs/appId" },
    "repo": { "type": "string", "pattern": "^mcg-[a-z0-9-]+$" },
    "team": { "$ref": "common.schema.json#/$defs/teamId" },
    "epic": { "type": "string", "pattern": "^[A-Z]{2,4}-\\d+$" },
    "sprint": { "type": "integer", "minimum": 1, "maximum": 13 },
    "points": { "type": "integer", "minimum": 1, "maximum": 13 },
    "status": { "type": "string", "enum": ["done", "in_progress", "in_review", "backlog", "cancelled"] },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "resolved_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "release": { "$ref": "common.schema.json#/$defs/releaseId" },
    "labels": { "type": "array", "items": { "type": "string" } },
    "related_incident": { "$ref": "common.schema.json#/$defs/incidentId" },
    "prs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/prId" } }
  },
  "unevaluatedProperties": false
}

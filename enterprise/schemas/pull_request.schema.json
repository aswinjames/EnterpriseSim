{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://enterprisesim.dev/schemas/2020-12/pull_request.schema.json",
  "title": "PullRequest",
  "description": "A GitHub pull request with global index PR-#### and native <repo>#<n> per CANON-001 §5.",
  "type": "object",
  "allOf": [{ "$ref": "common.schema.json#/$defs/eclObjectBase" }],
  "required": ["id", "repo", "native_number", "title", "app", "team", "author", "story", "state", "created_at"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/prId" },
    "repo": { "type": "string", "pattern": "^mcg-[a-z0-9-]+$" },
    "native_number": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "app": { "$ref": "common.schema.json#/$defs/appId" },
    "team": { "$ref": "common.schema.json#/$defs/teamId" },
    "author": { "type": "string" },
    "story": { "type": "string", "pattern": "^[A-Z]{2,4}-\\d+$" },
    "branch": { "type": "string" },
    "base": { "type": "string", "enum": ["main"] },
    "state": { "type": "string", "enum": ["merged", "open", "closed"] },
    "merged_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "commits": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" } },
    "additions": { "type": "integer", "minimum": 0 },
    "deletions": { "type": "integer", "minimum": 0 },
    "changed_files": { "type": "integer", "minimum": 0 },
    "reviews": { "type": "integer", "minimum": 0 },
    "approvals": { "type": "integer", "minimum": 0 },
    "risk_tier": { "type": "integer", "minimum": 0, "maximum": 3 },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ci": { "type": "string", "enum": ["passed", "failed"] },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "test_run": { "$ref": "common.schema.json#/$defs/testRunId" },
        "security_scan": { "type": "string", "enum": ["passed", "failed", "waived"] }
      }
    },
    "release": { "$ref": "common.schema.json#/$defs/releaseId" },
    "is_hotfix": { "type": "boolean" },
    "labels": { "type": "array", "items": { "type": "string" } }
  },
  "unevaluatedProperties": false
}
